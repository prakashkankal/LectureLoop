{
  "name": "lectureloop-oral-test-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "lint": "npm run lint --workspace client && npm run lint --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}