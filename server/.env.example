# Server Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://kankalprakash96_db_user:eVGIW61V37KsFY7Y@cluster0.pb9d7l0.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional comma-separated backup keys; the single-key variable above remains supported
# OPENAI_API_KEYS=your_openai_api_key_1,your_openai_api_key_2
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional Cloudinary persistent storage (falls back automatically to MongoDB GridFS & local persistent store)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEMINI_API_KEY=your_gemini_api_key_here
# Optional comma-separated backup keys
# GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# Optional comma-separated backup keys
# ASSEMBLYAI_API_KEYS=your_assemblyai_api_key_1,your_assemblyai_api_key_2
GROQ_API_KEY=your_groq_api_key_here
# Optional comma-separated backup keys
# GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
# Optional Groq chat-model override; defaults to supported model IDs with automatic fallbacks
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
META_API_KEY=your_meta_model_api_key_here
# Optional comma-separated backup keys
# META_API_KEYS=your_meta_model_api_key_1,your_meta_model_api_key_2
META_MODEL=muse-spark-1.3
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional comma-separated backup keys
# ANTHROPIC_API_KEYS=your_anthropic_api_key_1,your_anthropic_api_key_2
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_TEXT_MODEL=gpt-4o-mini
IOT_UPLOAD_TOKEN=replace_with_a_long_random_device_upload_token
